{
  "record_decision": {
    "type": "webhook",
    "name": "record_decision",
    "description": "Record the owner's confirmed decision for ONE listed date and start publication for an approval or edit. A clear yes to an exact proposal is sufficient; edited hours require a read-back and yes. A clear request to keep the current listing is DECLINE. Wait for the result, then acknowledge only when useful and continue naturally. A saved decision does not prove publication has finished.",
    "response_timeout_secs": 20,
    "follow_redirects": false,
    "follow_redirects_allowed_domains": [],
    "dynamic_variables": {
      "dynamic_variable_placeholders": {
        "call_id": {
          "type": "string_literal",
          "value": "preview"
        }
      }
    },
    "assignments": [],
    "interruption_mode": "disable_during_tool",
    "pre_tool_speech": "auto",
    "tool_call_sound": "typing",
    "tool_call_sound_behavior": "always",
    "execution_mode": "immediate",
    "tool_error_handling_mode": "passthrough",
    "response_mocks": [],
    "api_schema": {
      "url": "https://coveted-anemia-celestial.ngrok-free.dev/voice/tools/record-decision",
      "method": "POST",
      "path_params_schema": [],
      "query_params_schema": [],
      "request_headers": [],
      "content_type": "application/json",
      "auth_connection": null,
      "mtls_auth_connection": null,
      "response_filter": null,
      "request_body_schema": {
        "id": "body",
        "type": "object",
        "description": "The owner's confirmed decision for one suggested date.",
        "required": true,
        "value_type": "llm_prompt",
        "dynamic_variable": "",
        "properties": [
          {
            "id": "call_id",
            "type": "string",
            "description": "",
            "dynamic_variable": "call_id",
            "constant_value": "",
            "value_type": "dynamic_variable",
            "required": true,
            "enum": null
          },
          {
            "id": "conversation_id",
            "type": "string",
            "description": "",
            "dynamic_variable": "system__conversation_id",
            "constant_value": "",
            "value_type": "dynamic_variable",
            "required": true,
            "enum": null
          },
          {
            "id": "item",
            "type": "integer",
            "description": "Item number of the date from the suggestions list (1, 2, 3 or 4).",
            "dynamic_variable": "",
            "constant_value": "",
            "value_type": "llm_prompt",
            "required": true,
            "enum": null
          },
          {
            "id": "decision",
            "type": "string",
            "description": "APPROVE = our suggested hours as they are. EDIT = the owner gave other hours. DECLINE = keep what the listing shows now.",
            "dynamic_variable": "",
            "constant_value": "",
            "value_type": "llm_prompt",
            "required": true,
            "enum": [
              "APPROVE",
              "EDIT",
              "DECLINE"
            ]
          },
          {
            "id": "hours",
            "type": "string",
            "description": "Only for EDIT. 24-hour format HH:MM-HH:MM, e.g. 10:00-14:00. Several ranges separated by commas, e.g. 10:00-14:00,17:00-22:00. Use 'closed' for closed all day. Leave empty for APPROVE and DECLINE.",
            "dynamic_variable": "",
            "constant_value": "",
            "value_type": "llm_prompt",
            "required": false,
            "enum": null
          },
          {
            "id": "confirmed",
            "type": "boolean",
            "description": "true only after explicit agreement to this date's exact proposed or read-back hours, or an explicit request to keep its currently listed hours. For EDIT, read back the date and complete final hours and get a clear yes. Hesitation or agreement about another date is not confirmation.",
            "dynamic_variable": "",
            "constant_value": "",
            "value_type": "llm_prompt",
            "required": true,
            "enum": null
          },
          {
            "id": "owner_comment",
            "type": "string",
            "description": "Optional. Anything the owner said that a colleague should know, in one short sentence. Empty if nothing.",
            "dynamic_variable": "",
            "constant_value": "",
            "value_type": "llm_prompt",
            "required": false,
            "enum": null
          }
        ]
      }
    }
  },
