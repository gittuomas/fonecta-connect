# Copy to .env and configure the services you will evaluate. .env is gitignored; never commit real keys.
# OpenShift AI below is required for the full free-text reply experience, including the browser demo.
# Load it in your shell with: set -a; source .env; set +a   (the Python code reads .env by itself)
YEXT_BASE_URL=https://sbx-api.yextapis.com
YEXT_API_KEY=
# auto: prefer a read-verified sandbox, otherwise clearly labelled local simulation.
# sandbox: require real Yext, fail closed. demo: use local simulator.
CONNECT_APPLY_MODE=auto
# One-to-one mapping from challenge business to the real sandbox entity.
# Our sandbox business's entity ID is its name, spaces and é included.
# FI-D0001 is the submission business. Another case needs a separate entity or a remap.
YEXT_SANDBOX_MIRROR=FI-D0001:Cinnamon Swirl Café

# Optional live event ingestion: Ticketmaster Consumer Key (no consumer secret needed).
# Register at https://developer-account.ticketmaster.com/user/register
TICKETMASTER_API_KEY=

# Optional: after `python -m live_signals refresh` and `python -m live_signals checks`,
# enable the generated hours checks in the existing owner app. Restart after refreshing.
# CONNECT_LIVE_CHECKS=live_signals/.runtime/checks.json
# Or refresh events + Open-Meteo weather and launch with a read-verified sandbox:
# python -m live_signals.demo --sandbox
# Open-Meteo needs no API key for this noncommercial demo.

# Required for evaluating natural-language replies: the AI model on Red Hat OpenShift AI
# that reads owners' typed opening-hour replies, including in the WhatsApp-style browser demo.
# (app/hours_ai.py). URL and model name are Laura's sandbox deployment. The token is a secret:
# obtain it from your deployment administrator and save it here (never commit it).
# Deployment previously documented by the team (availability must be checked):
# https://granite-hours-lauradsalminen-dev.apps.rm1.0a51.p1.openshiftapps.com
# Leave BOTH URL and token empty for exact-format parsing without AI.
# If either is configured, errors require clarification; there is no silent fallback.
OPENSHIFT_AI_URL=
OPENSHIFT_AI_MODEL=granite-hours
OPENSHIFT_AI_TOKEN=

# Optional actual WhatsApp delivery; browser previews do not need these.
# See app/MESSAGING.md for sender/template approval and recipient setup.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_CONTENT_SID=
CONNECT_PUBLIC_URL=
CONNECT_MESSAGING_CONTACTS=

# ElevenLabs voice. Copy the supplied agent prompt/tools into your configured agent.
ELEVENLABS_AGENT_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
DEMO_OWNER_PHONE=
PUBLIC_BASE_URL=http://localhost:8000
YEXT_SANDBOX_ENTITY_ID=Cinnamon Swirl Café
